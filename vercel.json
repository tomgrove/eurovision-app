{
  "version": 2,
  "buildCommand": "cd client && yarn install && yarn build",
  "outputDirectory": "client/build",
  "framework": "react",
  "env": {
    "REACT_APP_API_URL": "@api_url"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}
